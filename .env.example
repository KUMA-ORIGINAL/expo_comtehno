DEBUG=1
SECRET_KEY=abc
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=django_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

GET_CERTS=False                          # True для получения сертификатов (обязательно укажите email в CERTBOT_EMAIL
CERTBOT_EMAIL=example@example.com        # Email для регистрации certbot
DOMAIN=exemple.com                       # Домен на котором вы разворачиваете

# Celery (очередь писем; по умолчанию как в settings)
CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_TASK_ALWAYS_EAGER=1            # для отладки без worker — задачи выполняются в процессе веба
# REGISTRATION_EMAIL_VIA_CELERY=1      # письма после регистрации только через Celery (иначе — сразу из веба)

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Production CORS
# CORS_ALLOWED_ORIGINS=https://exemple.com,https://www.exemple.com
# CORS_ALLOW_CREDENTIALS=1

# Docker worker
# REGISTRATION_EMAIL_VIA_CELERY=1
